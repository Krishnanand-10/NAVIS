# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Generated output. Figures, logs, cached training clips (~64 MB) and
# checkpoints are all reproducible from scripts/, so none of them belong in
# git. The single exception is the exported ONNX model: the Android side needs
# it and should not have to reproduce a training run to get one.
pipeline/out/*
!pipeline/out/speednet.onnx

